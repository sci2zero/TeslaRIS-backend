package versions {
  enum QualityDimension {
  	ACCURACY
  	CONSISTENCY
  	LINEAGE
  	STRUCTURAL_CONSISTENCY
  	QUALITATIVE
  	SEMANTIC
  	CURRENCY
  }
  
  
  enum IssueSeverity {
    INFO
    WARNING
    ERROR
  }
  
  class EntityRevision extends BaseEntity {  	
  	Integer baseEntityId
  	String entityType 
  	Integer majorVersion
  	Integer minorVersion
  	Instant revisionTimestamp
  	String contentHash
  	byte[] compressedContent
  	Boolean currentVersion /' !!! do we need this? '/
  }
  
  EntityRevision "1" --> "*" DegradedReference : restorationWarnings
  
  class DegradedReference {  	
    String messageKey 
    String fieldPath
    List<String> parameters
    DegradationOutcome outcome 
  }
  
  enum DegradationOutcome {
    /' The reference was left unset. Used for values the entity can exist without. '/
    DROPPED
    /' The reference was replaced by a weaker representation that keeps the information visible,
       e.g. a contributor kept as a display name instead of a link to a person. '/
    DEGRADED
  }  
  
  /' !!! '/
  class DataQualityProfile {
    Integer id
    Set<MultilingualContent> title /' for instance PTCRIS-DATAGOV '/
    String version /' for instance 1.0 '/
    String uri
  }
  
  class DataQualityAssessment extends BaseEntity {
      DataQualityProfile dataQualityProfile    
      RepositoryRecordVersion recordVersion
      /' Version of the validator implementation.
         Useful when rules change without profile changes. '/
      String engineVersion
      Instant startedAt
      Instant finishedAt
      Boolean valid
      Boolean publicationCandidate
      Integer passedConstraints
      Integer infoFailedConstraints
      Integer warningFailedConstraints
      Integer errorFailedConstraints
      
      Integer activitiesCount
      
      Double totalPoints
      Double achievedPointsNormalised
      Double qualityScore
      Double totalPointsFair
      Double achievedFairPointsNormalised
      Double qualityScoreFair
      
      Map<QualityDimension, DimensionScore> dimensionScores
            
      Set<MultilingualContent> summary
      Long executionTimeMs
  }
  
  class DimensionScore {
    Double achievedPoints
    Double totalPoints
    Double percentage
  }
  
  class ConstraintEvaluationResult {
      /' !!! denormalized model for the purpose of better performance
      if it is not needed for performance, we can remove it and use only
      relation to DataQualityAssessment, where we can find all those information: 
      
      Integer recordVersionDataQualityReportId
      Integer baseEntityId   
      Integer recordVersionId    
      Integer recordMajorVersion 
      Integer recordMinorVersion 
      Integer dataQualityPolicyId '/   
      
      LocalDate assessmentDate  /' !!! although this exists in linked DataQualityAssessment, might be useful here '/      
      Long executionTimeMs
      
      /' !!! if we decide to preserve only failed constraints, this field is not needed 
      Boolean passed 
      '/
      
      /' !!! based on linked Constraint and DataQualityProfile we might find information below, but we should consider
      whether we should preserve in CER
      Moreover, if we preserve only failed constraints, the score is 0  
            
      Float score 
      Float validationTargetWeight
      Float constraintWeight
      '/
      
      String actualValue /' !!!!! this probably should be added, there is List<String> parameters, not sure whether it is planned to be used here '/   
      
      String key
            
      /' this is defined below in relations     
      QualityDimension dimension 
    
      IssueSeverity severity '/
      
      ApplicableEntityType targetObjectType       
      Boolean fairComplianceConstraint /' !!! entitled usedForFairCompliance at the moment  '/ 
      String validationTarget /' !!! entitled target at the moment  '/   
  
      String validationPath
      String constraintTypeKey
      Set<MultilingualContent> title /' should we preserve only label key, not real translation '/
      Set<MultilingualContent> message  
      
      Set<MultilingualContent>  policyRequirementTitle /' in the case of PT this is metric '/
      Set<MultilingualContent>  policyRequirementAbbreviation
      Set<MultilingualContent>  policyRequirementDescription
      String policyRequirementUri
          
      Set<MultilingualContent> policyDimensionTitle
      Set<MultilingualContent> policyDimensionDescription
      String policyDimensionUri 
          
      Double validationTargetWeight
      Double constraintWeight    
          
      Boolean blocking 
      
  }
  
  ConstraintEvaluationResult --> DataQualityAssessment
  ConstraintEvaluationResult --> IssueSeverity : severity /' !!! entitled severity at the moment  '/
  ConstraintEvaluationResult --> QualityDimension : dimension /' !!! entitled dimension at the moment  '/
  DataQualityAssessment --> EntityRevision 
  DataQualityAssessment --> DataQualityProfile

}

@enduml
